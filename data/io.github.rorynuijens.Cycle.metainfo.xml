<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.rorynuijens.Cycle</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Cycle</name>
  <summary>Indoor cycling training with smart trainer control</summary>

  <description>
    <p>
      Cycle is a GNOME application for indoor cycling training. It connects to BLE
      smart trainers via FTMS, lets you run structured ERG workouts, records sessions
      with power, heart rate, and cadence data, and provides AI coaching advice through
      the Claude API.
    </p>
    <p>Features:</p>
    <ul>
      <li>BLE smart trainer control via FTMS (ERG mode)</li>
      <li>Structured workout player with power zone visualisation</li>
      <li>Session recording: power, heart rate, cadence</li>
      <li>Training load tracking (CTL / ATL / TSB)</li>
      <li>AI coaching suggestions powered by the Anthropic Claude API</li>
      <li>Intervals.icu integration for activity sync</li>
      <li>FIT file export</li>
      <li>Post-workout self-evaluation (RPE)</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.rorynuijens.Cycle.desktop</launchable>

  <!--
    GNOME Software fetches these over the network, so they must be absolute
    URLs to a public host - it cannot read files from inside the flatpak.
    Pinned to main rather than a tag so one set serves every release; if a
    file here is ever renamed, older releases lose their screenshots.
  -->
