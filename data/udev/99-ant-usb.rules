# Grant the logged-in desktop user access to Garmin/Dynastream ANT USB sticks,
# so Cycle can open them via libusb without root.
#
# Install:
#   sudo cp data/udev/99-ant-usb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Then replug the ANT stick.
#
# 0fcf:1008 = ANTUSB2, 0fcf:1009 = ANTUSB-m
# TAG+="uaccess" grants the active-seat user access via logind ACLs; MODE="0666"
# is a logind-independent fallback so access works even from a toolbox container.
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fcf", ATTRS{idProduct}=="1008", TAG+="uaccess", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fcf", ATTRS{idProduct}=="1009", TAG+="uaccess", MODE="0666"
